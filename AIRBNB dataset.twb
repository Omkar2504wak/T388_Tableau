      <aliases enabled='yes' />
      <column caption='Review performance score' datatype='integer' name='[Calculation_0398633135349760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='price category' datatype='string' name='[Calculation_0398633137156097]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF[Price]&gt;300 THEN &quot;LUXURY&quot; &#13;&#10;ELSEIF [Price]&gt;150 THEN &quot;STANDARD&quot;&#13;&#10;ELSE &quot;BUDGET&quot;&#13;&#10;END' />
      </column>
      <column caption='Count of Hotels' datatype='integer' name='[Calculation_0398633140899842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='HOST STATUS' datatype='string' name='[Calculation_0398633143971843]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt; TODAY()THEN &quot;ACTIVE HOST&quot;&#13;&#10;ELSE &quot;NEW HOST&quot;&#13;&#10;END' />
      </column>
      <column caption='REVIEW CATEGORY' datatype='string' name='[Calculation_0398633144885252]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100&#13;&#10;THEN &quot;HIGHLY REVIEWED&quot;&#13;&#10;ELSE &quot;LESS Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='price fliter category' datatype='string' name='[Calculation_0398633146765318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0398633145806853]&#13;&#10;THEN &quot;ABOVE Limit&quot;&#13;&#10;ELSE &quot;below limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since_New' datatype='date' name='[Calculation_0398633152188424]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since], DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='New Host since' datatype='date' name='[Calculation_0398633153351689]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Review score Rating (New)' datatype='string' name='[Calculation_0398633155977226]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]), &quot;Not Rated&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
